# Versions for an image bundle. Bump VERSION for every bundle you carry across the air gap.
VERSION=0.1.0
PYTHON_BASE=python:3.12-slim-bookworm
BUILD_BASE=debian:bookworm-slim
POSTGRES_IMAGE=postgres:16.9-alpine
# Standalone CPython for the agent layer (https://github.com/astral-sh/python-build-standalone/releases).
PBS_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20250818/cpython-3.12.11+20250818-x86_64-unknown-linux-gnu-install_only.tar.gz
# Extra upstream images to carry over unchanged (space separated), e.g. the runner helper matching your runner.
EXTRA_IMAGES="registry.gitlab.com/gitlab-org/gitlab-runner/gitlab-runner-helper:x86_64-v17.11.0"
