# --- images ---------------------------------------------------------------
REGISTRY=registry.internal
VERSION=0.1.0
POSTGRES_TAG=16.9-alpine

# --- GitLab ----------------------------------------------------------------
GITLAB_URL=https://gitlab.internal
# Username of the service account the platform acts as (its comments are ignored to prevent loops).
BOT_USERNAME=agent-bot
# What people type in comments. Using the bot's username (e.g. @agent-bot) also gives them autocomplete.
AGENT_MENTION=@agent
# The sandbox project that runs agent jobs (path or numeric id).
SANDBOX_PROJECT=agent-platform/sandbox
SANDBOX_REF=main
# Optional: secret file name of a token used only to trigger sandbox pipelines (defaults to each project's token).
# SANDBOX_TOKEN_REF=sandbox_trigger_token

# --- orchestrator ----------------------------------------------------------
# URL of this orchestrator as reachable FROM SANDBOX JOBS (bundle download / result upload).
PUBLIC_URL=http://agent-orchestrator.internal:8080
# Keep at or below the runner's `limit` and what the GPU serves without queueing.
MAX_CONCURRENT_SANDBOXES=2
QUEUE_GRACE_MINUTES=30
POLL_INTERVAL_SECONDS=5
# TLS_CA_FILE=/certs/ca.crt
LISTEN_PORT=8080

# --- chat (inline agents run inside the orchestrator worker) --------------------
# The orchestrator host must reach vLLM. Leave unset to disable chat (projects must also list `chat` in agents).
LLM_BASE_URL=http://vllm.internal:8000/v1
LLM_MODEL=qwen3.8-27b
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# LLM_CA_FILE=/certs/ca.crt
# Concurrent chat conversations, separate from MAX_CONCURRENT_SANDBOXES.
CHAT_WORKERS=2

# --- feedback and eval export ------------------------------------------------------
# How often the worker reads 👍/👎 on agent notes and MRs, and for how many days after a task.
FEEDBACK_POLL_SECONDS=300
FEEDBACK_WINDOW_DAYS=14
# Exported eval fixtures include the whole repository up to this size; larger ones only the touched files.
FIXTURE_MAX_REPO_MB=20
