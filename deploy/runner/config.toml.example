# GitLab Runner for agent sandboxes. Register it on the sandbox project (or its group) with tag `agent-sandbox`,
# "run untagged jobs" disabled and "protected" off. Only this runner should carry the tag.
concurrent = 4

[[runners]]
  name = "agent-sandbox"
  url = "https://gitlab.internal"
  token = "glrt-REPLACE_ME"
  executor = "docker"
  # Max simultaneous agent jobs: each holds a live session on vLLM. Match it to what the GPU serves
  # without queueing, and keep MAX_CONCURRENT_SANDBOXES in the orchestrator at or below it.
  limit = 2
  request_concurrency = 2
  # tls-ca-file = "/etc/gitlab-runner/certs/ca.crt"

  [runners.docker]
    image = "registry.internal/agent-platform/sandbox-python:0.1.0"
    helper_image = "registry.internal/gitlab-org/gitlab-runner/gitlab-runner-helper:x86_64-v17.11.0"
    # Only images from the internal agent-platform namespace may run here.
    allowed_images = ["registry.internal/agent-platform/*:*"]
    allowed_services = []
    pull_policy = ["if-not-present"]
    allowed_pull_policies = ["if-not-present"]
    privileged = false
    security_opt = ["no-new-privileges:true"]
    cap_drop = ["ALL"]
    cap_add = ["CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID"]
    # No docker.sock, no host paths, no shared cache between jobs.
    volumes = []
    disable_cache = true
    # Egress is restricted at the host firewall: see egress-firewall.sh.
    network_mode = "agent-sandbox"
    memory = "8g"
    memory_swap = "8g"
    cpus = "4"
    shm_size = 268435456
